# AuraSaaS local development configuration

APP_NAME=AuraSaaS
APP_DESCRIPTION=Open-source AI Business Intelligence Agent Platform
API_PREFIX=/api

# LLM provider. Leave the placeholder for demo-mode behavior.
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_BASE=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Data stores
DATABASE_URL=sqlite:///./aura.db
CHROMA_DIR=./data/chroma
CODE_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
CODE_EMBEDDING_CACHE_DIR=./data/huggingface

# Auth and runtime
JWT_SECRET=change-me-in-production
ENVIRONMENT=local
SEED_DEMO_ON_STARTUP=true
FORCE_RESEED_DEMO=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TEXT_ENCODING=utf-8
