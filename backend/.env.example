# =============================================================================
# AuraSaaS — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# cp .env.example .env
# =============================================================================

# --- LLM API ---
# DeepSeek (or OpenAI-compatible) API key
# Leave as placeholder for demo mode (template-based fallback responses)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Database ---
# SQLite (local development, default)
DATABASE_URL=sqlite:///./aura.db

# PostgreSQL (production / staging)
# DATABASE_URL=postgresql://user:password@localhost:5432/aurasaas

# --- Redis (optional) ---
# Empty = disabled, falls back to in-memory alternatives
# Set to a valid Redis URL to enable Redis-backed caching and rate limiting
# REDIS_URL=redis://localhost:6379/0

# --- Vector Store ---
CHROMA_DIR=./data/chroma

# --- JWT ---
JWT_SECRET=change-me-in-production

# --- App ---
ENVIRONMENT=local
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Demo Data ---
SEED_DEMO_ON_STARTUP=true
FORCE_RESEED_DEMO=false

# --- LLM Tuning ---
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# --- Agent Budget ---
AGENT_BUDGET_YUAN=0.02
